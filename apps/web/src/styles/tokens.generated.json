{
  "colors": {
    "canvas": "#131520",
    "panel": "#1B1E2A",
    "field": "#181B26",
    "raised": "#252937",
    "raised-hover": "#2E3343",
    "overlay": "#222633",
    "line": "rgb(214 219 255 / 0.10)",
    "line-subtle": "rgb(214 219 255 / 0.05)",
    "line-strong": "rgb(214 219 255 / 0.20)",
    "line-glass": "rgb(214 219 255 / 0.08)",
    "line-control": "rgb(214 219 255 / 0.45)",
    "hover": "rgb(214 219 255 / 0.05)",
    "pressed": "rgb(214 219 255 / 0.10)",
    "scrim": "rgb(4 5 10 / 0.65)",
    "media-scrim": "#000000",
    "media-wash": "color-mix(in srgb, var(--color-media-scrim) 20%, transparent)",
    "media-chip": "color-mix(in srgb, var(--color-media-scrim) 70%, transparent)",
    "media-heavy": "color-mix(in srgb, var(--color-media-scrim) 85%, transparent)",
    "canvas-veil": "color-mix(in srgb, var(--color-canvas) 30%, transparent)",
    "panel-glass": "color-mix(in srgb, var(--color-panel) 50%, transparent)",
    "panel-veil": "color-mix(in srgb, var(--color-panel) 85%, transparent)",
    "panel-frost": "color-mix(in srgb, var(--color-panel) 82%, transparent)",
    "card-glass": "color-mix(in srgb, var(--color-panel) 68%, transparent)",
    "overlay-frost": "color-mix(in srgb, var(--color-overlay) 86%, transparent)",
    "raised-frost": "color-mix(in srgb, var(--color-raised) 72%, transparent)",
    "frost-outline": "color-mix(in srgb, var(--color-panel) 45%, transparent)",
    "fg": "#F3F4F8",
    "fg-secondary": "#A6A9BC",
    "fg-disabled": "#71758A",
    "on-brand": "#FFFFFF",
    "on-brand-soft": "color-mix(in srgb, var(--color-on-brand) 15%, transparent)",
    "on-brand-line": "color-mix(in srgb, var(--color-on-brand) 30%, transparent)",
    "on-brand-line-strong": "color-mix(in srgb, var(--color-on-brand) 60%, transparent)",
    "fg-hover": "color-mix(in srgb, var(--color-fg) 90%, transparent)",
    "brand": "#6D6AF5",
    "brand-strong": "#5550E0",
    "brand-deep": "#2B2585",
    "brand-fg": "#B5B3FF",
    "brand-soft": "rgb(109 106 245 / 0.15)",
    "brand-soft-hover": "rgb(109 106 245 / 0.25)",
    "brand-line": "rgb(109 106 245 / 0.35)",
    "shell-1": "#4B44C9",
    "shell-2": "#231E6B",
    "success": "#22C55E",
    "warning": "#FB923C",
    "danger": "#EF4444",
    "danger-fg": "#FCA5A5",
    "danger-fill": "#C53030",
    "success-soft": "rgb(34 197 94 / 0.15)",
    "warning-soft": "rgb(251 146 60 / 0.15)",
    "danger-soft": "rgb(239 68 68 / 0.15)",
    "danger-line": "color-mix(in srgb, var(--color-danger) 30%, transparent)",
    "warning-line": "color-mix(in srgb, var(--color-warning) 40%, transparent)",
    "danger-fill-hover": "color-mix(in srgb, var(--color-danger-fill) 90%, transparent)",
    "instagram": "#BE185D",
    "whatsapp": "#16A34A",
    "facebook": "#2563EB",
    "linkedin": "#1E40AF"
  },
  "colorAliases": {
    "chart-positive": "success",
    "chart-neutral": "fg-secondary",
    "chart-negative": "danger",
    "chart-series-1": "brand"
  },
  "shadows": {
    "floating": "0 8px 24px -6px rgb(0 0 0 / 0.7)",
    "overlay": "0 24px 64px -12px rgb(0 0 0 / 0.8)",
    "glass": "inset 0 1px 0 0 rgb(255 255 255 / 0.06), 0 1px 2px rgb(0 0 0 / 0.30), 0 12px 32px -14px rgb(0 0 0 / 0.65)",
    "highlight": "inset 0 1px 0 0 rgb(255 255 255 / 0.06)",
    "button-primary": "inset 0 1px 0 0 rgb(255 255 255 / 0.22), 0 8px 22px -8px color-mix(in srgb, var(--color-brand) 60%, transparent)",
    "button-secondary": "inset 0 0 0 1px var(--color-line-glass), inset 0 1px 0 0 rgb(255 255 255 / 0.06)",
    "glow": "0 25px 50px -12px color-mix(in srgb, var(--color-brand) 15%, transparent)",
    "glow-hover": "0 20px 25px -5px color-mix(in srgb, var(--color-brand) 10%, transparent), 0 8px 10px -6px color-mix(in srgb, var(--color-brand) 10%, transparent)",
    "glow-button": "0 10px 15px -3px color-mix(in srgb, var(--color-brand) 25%, transparent), 0 4px 6px -4px color-mix(in srgb, var(--color-brand) 25%, transparent)"
  },
  "fontSizes": {
    "2xs": {
      "size": "0.6875rem",
      "lineHeight": "1rem"
    },
    "md": {
      "size": "0.9375rem",
      "lineHeight": "1.5rem"
    }
  },
  "tracking": {
    "eyebrow": "0.08em"
  },
  "leading": {
    "display": "1.08"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem"
  },
  "easings": {
    "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
    "enter": "cubic-bezier(0, 0, 0.2, 1)",
    "exit": "cubic-bezier(0.4, 0, 1, 1)"
  },
  "breakpoints": {
    "md": "48rem",
    "lg": "64rem",
    "xl": "80rem",
    "wide": "90rem"
  },
  "motion": {
    "fast": "120ms",
    "normal": "150ms",
    "slow": "200ms"
  },
  "gradients": {
    "brand": "linear-gradient(135deg, var(--color-brand-deep) 0%, var(--color-brand-strong) 100%)",
    "brand-decor": "linear-gradient(135deg, var(--color-brand-deep) 0%, var(--color-brand) 100%)",
    "shell": "linear-gradient(135deg, var(--color-shell-1) 0%, var(--color-shell-2) 100%)",
    "glow-brand": "radial-gradient(120% 140% at 0% 0%, var(--color-brand-soft), transparent 60%)",
    "glow-brand-top": "radial-gradient(50% 55% at 50% 0%, var(--color-brand-soft), transparent 70%)",
    "ambient": "radial-gradient(60rem 38rem at 0% -12%, color-mix(in srgb, var(--color-brand) 20%, transparent), transparent 62%), radial-gradient(48rem 32rem at 100% -4%, color-mix(in srgb, var(--color-brand-strong) 13%, transparent), transparent 60%), radial-gradient(64rem 40rem at 55% 115%, color-mix(in srgb, var(--color-brand-deep) 32%, transparent), transparent 65%)"
  },
  "shadcn": {
    "background": "canvas",
    "foreground": "fg",
    "card": "panel",
    "card-foreground": "fg",
    "popover": "overlay",
    "popover-foreground": "fg",
    "primary": "brand-strong",
    "primary-foreground": "on-brand",
    "secondary": "raised",
    "secondary-foreground": "fg",
    "muted": "field",
    "muted-foreground": "fg-secondary",
    "accent": "hover",
    "accent-foreground": "fg",
    "destructive": "danger",
    "border": "line",
    "input": "line-control",
    "ring": "brand"
  },
  "variants": {
    "dark": "&:is(.dark *)",
    "short": "@media (max-height: 500px)"
  },
  "utilities": {
    "mask-fade-x": "mask-image: linear-gradient(to right, black calc(100% - 1rem), transparent)",
    "shadow-crop-mask": "box-shadow: 0 0 0 9999px color-mix(in srgb, var(--color-media-scrim) 60%, transparent)"
  }
}
