# The API's and worker's settings on the VM (C-145): /opt/amplychat/api.env, mode 600, never
# committed. Create it with `infra/vm/gen-secrets.sh`, which copies this file, fills every
# [generated] value with a random one and leaves the [owner] values empty for you to paste.
# Every setting is in apps/api/src/socialhood/settings.py; production refuses to start while any
# required one is empty and lists them all (docs/ops/deploy-vm.md, "Full stack").
#
# Tags (the comment line right above a block of variables):
#   [fixed]      the production value; change it only if the domains change
#   [generated]  random, made by gen-secrets.sh (how is written next to each)
#   [owner]      from a vendor account the business owns; paste it after the "="
#
# Format: KEY=value on one line, no quotes, no spaces around "=", no comments after the value.

# --------------------------------------------------------------------------- environment
# [fixed]
APP_ENV=production
LOG_LEVEL=INFO
API_BASE_URL=https://api.amplychat.com
WEB_BASE_URL=https://amplychat.com
CORS_ALLOWED_ORIGINS=https://amplychat.com
CLERK_AUTHORIZED_PARTIES=https://amplychat.com
# Caddy replaces any X-Forwarded-For a client sends with the address it connected from; the API
# reads it from the right, past the private (compose) addresses (security/client_ip.py).
CLIENT_IP_HEADER=x-forwarded-for
SANDBOX_PLATFORM_ENABLED=false

# --------------------------------------------------------------------------- data (compose services)
# [generated] the postgres password (openssl rand -hex 24), the same one gen-secrets.sh writes to
# postgres.env. The API adds the asyncpg driver itself; the queue and migrations use the direct URL.
DATABASE_URL=postgresql://socialhood:__POSTGRES_PASSWORD__@postgres:5432/socialhood
DATABASE_URL_DIRECT=postgresql://socialhood:__POSTGRES_PASSWORD__@postgres:5432/socialhood
# [fixed]
REDIS_URL=redis://valkey:6379/0

# --------------------------------------------------------------------------- workers and limits
# [fixed] a 2-vCPU VM shared with Postgres and the web: the staging-sized lanes. Raise with care.
WORKER_INTERACTIVE_CONCURRENCY=10
WORKER_BULK_CONCURRENCY=4
BULK_CONCURRENCY_PER_WORKSPACE=4
AI_DAILY_SPEND_LIMIT_USD=100
POST_VIDEO_MAX_MB=100

# --------------------------------------------------------------------------- operations
# [generated] guards /metrics and /readyz (openssl rand -hex 32)
METRICS_TOKEN=
# [owner] Sentry → project socialhood-api → Client Keys (DSN)
SENTRY_DSN=
# [fixed]
SENTRY_TRACES_SAMPLE_RATE=0.1

# --------------------------------------------------------------------------- Clerk (production instance)
# [owner] Clerk → API keys: the secret key; the PEM public key on ONE line with literal \n between
# its lines; the Frontend API URL (https://clerk.amplychat.com). Webhooks → the endpoint's signing
# secret (whsec_...).
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# --------------------------------------------------------------------------- encryption
# [generated] a Fernet key (openssl rand 32 | base64 | tr '+/' '-_'). When rotating, put the new
# key first and keep the old ones after it, comma-separated.
TOKEN_ENCRYPTION_KEYS=

# --------------------------------------------------------------------------- Meta: Instagram, WhatsApp
# [owner] Meta app → Instagram → API setup with Instagram login (app id and secret); Settings →
# Basic (app id and secret); WhatsApp → Embedded Signup configuration id.
IG_APP_ID=
IG_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_CONFIG_ID=
# [generated] typed into Meta's webhook forms too (openssl rand -hex 32)
IG_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# [fixed] true only after Meta approves each permission
IG_REDIRECT_URI=https://api.amplychat.com/v1/oauth/instagram/callback
IG_GRAPH_VERSION=v25.0
META_GRAPH_VERSION=v25.0
IG_REQUEST_INSIGHTS_SCOPE=false
FB_REQUEST_INSIGHTS_SCOPE=false
IG_HUMAN_AGENT_ENABLED=false

# --------------------------------------------------------------------------- AI
# [owner] Google AI Studio / Cloud: a paid, billing-enabled Gemini key
GEMINI_API_KEY=

# --------------------------------------------------------------------------- media
# [owner] Cloudinary console → API keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --------------------------------------------------------------------------- billing (Dodo Payments)
# [owner] Dodo dashboard in live mode: API key, the webhook's secret, the product ids (Max: later)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_MAX_MONTHLY=
# [fixed]
DODO_ENVIRONMENT=live

# --------------------------------------------------------------------------- email and push
# [owner] Resend → API keys (sending access, the amplychat.com domain)
RESEND_API_KEY=
# [fixed]
EMAIL_FROM=Amplychat <support@amplychat.com>
VAPID_SUBJECT=mailto:support@amplychat.com
# [generated] a P-256 key pair in the web-push format (openssl ecparam -name prime256v1 -genkey;
# the same as `npx web-push generate-vapid-keys`). Changing it later unsubscribes every browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --------------------------------------------------------------------------- optional integrations
# Each feature stays off ("not set up") while its values are empty. Razorpay needs nothing here:
# each business stores its own keys in the app.
# [owner] Google Sheets sync (GR-27): a Google Cloud OAuth client, scope drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [fixed]
GOOGLE_REDIRECT_URI=https://api.amplychat.com/v1/oauth/google/callback
# [owner] Shopify app (GR-31): a Partner account and an app listing
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# [fixed]
SHOPIFY_REDIRECT_URI=https://api.amplychat.com/v1/oauth/shopify/callback
# Facebook Pages (GR-29) stays off until Meta approves it; then set both:
#   FB_REDIRECT_URI=https://api.amplychat.com/v1/oauth/facebook/callback
#   FB_WEBHOOK_VERIFY_TOKEN=<openssl rand -hex 32, also typed into Meta's Page webhook form>
