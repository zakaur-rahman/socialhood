# Social Hood web app (§2.16). Copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# The public site's origin for canonical URLs, Open Graph, sitemap.xml and robots.txt.
# Unset: https://app.socialhood.com.
NEXT_PUBLIC_SITE_URL=

# Clerk (from P1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Meta Embedded Signup (WhatsApp connect page only)
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=

# Sentry (T9.3): unset DSN = no Sentry. Source maps upload only when SENTRY_AUTH_TOKEN is set
# (Vercel build environment; never needed locally).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Push (TR-FE-09): the VAPID public key comes from the API's GET /v1/push/config (C-049).
# The service worker registers only in production builds; set to 1 to try push under next dev.
NEXT_PUBLIC_ENABLE_SW=
