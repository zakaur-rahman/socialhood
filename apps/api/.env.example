# Amplychat API and worker (§2.16). Copy to .env for local development.
# Values below are safe local defaults or blanks; production requires every blank to be set.

APP_ENV=local
API_BASE_URL=http://localhost:8000
# Production: https://api.amplychat.com and https://amplychat.com (the apex serves the site and
# the app under /app; www redirects to it, C-142). Email, OAuth and checkout links use WEB_BASE_URL.
WEB_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local Docker services (infra/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://socialhood:socialhood@localhost:5432/socialhood
DATABASE_URL_DIRECT=postgresql://socialhood:socialhood@localhost:5432/socialhood
BULK_CONCURRENCY_PER_WORKSPACE=4
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
# Sentry (T9.3): unset DSN = no Sentry. Release defaults to Render's RENDER_GIT_COMMIT.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=
# Guards /metrics and /readyz (SEC-12); unset = /metrics does not exist (404).
METRICS_TOKEN=

# Clerk (CLERK_JWT_KEY is the instance PEM public key; parties are comma-separated)
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SECRET=
# clerk, or fake to keep team invitations in memory (never in production)
CLERK_INVITATIONS_PROVIDER=clerk

# Fernet keys, newest first, comma-separated
TOKEN_ENCRYPTION_KEYS=

# Instagram API with Instagram Login
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:8000/v1/oauth/instagram/callback
IG_WEBHOOK_VERIFY_TOKEN=
IG_GRAPH_VERSION=v25.0
META_GRAPH_VERSION=v25.0
IG_REQUEST_INSIGHTS_SCOPE=false
FB_REQUEST_INSIGHTS_SCOPE=false
# The largest video a post upload accepts, in MB (10 to 300). Cloudinary's free plan stops single
# uploads at 100 MB; larger files go in chunks and need a plan that allows them (C-134).
POST_VIDEO_MAX_MB=100
IG_HUMAN_AGENT_ENABLED=false

# WhatsApp and Meta privacy callbacks
META_APP_ID=
META_APP_SECRET=
WHATSAPP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Development only: scripts/connect_whatsapp_number.py (docs/dev-whatsapp.md). Not read by the app.
# WHATSAPP_DEV_TOKEN=

# Gemini (paid-tier key only)
GEMINI_API_KEY=
AI_MODEL_ANALYSIS=gemini-3.5-flash-lite
AI_MODEL_REPLY=gemini-3.5-flash-lite
AI_MODEL_REPLY_COMPLEX=gemini-3.8-flash
AI_MODEL_EMBED=gemini-embedding-2
# Ask Amplychat's planner; unset: AI_MODEL_REPLY
# AI_MODEL_AGENT=gemini-3.5-flash-lite
AI_EMBED_DIM=768
# Thinking level per model (JSON); unset: minimal for Flash-Lite, low otherwise
# AI_THINKING_LEVELS={"gemini-3.8-flash": "low"}
AI_DAILY_SPEND_LIMIT_USD=100
AI_RETRIEVAL_MIN_SIM=0.60
AUTO_MIN_CONFIDENCE=0.75

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# test or live (test.dodopayments.com or live.dodopayments.com)
DODO_ENVIRONMENT=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_MAX_MONTHLY=
# dodo, or fake to run without Dodo (never in production)
DODO_PROVIDER=dodo

RESEND_API_KEY=
EMAIL_FROM=Amplychat <support@amplychat.com>
# resend, or fake to keep emails in memory (never in production)
EMAIL_PROVIDER=resend

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@amplychat.com
# webpush, or fake to keep pushes in memory (never in production)
PUSH_PROVIDER=webpush

# Google Sheets sync (GR-27): an OAuth client with the drive.file scope only, plus the callback
# address (<API>/v1/oauth/google/callback). google, or fake to keep sheets in memory (never in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/oauth/google/callback
GOOGLE_PROVIDER=google

# Shopify product import (GR-31): the Shopify app's client credentials (Partner account, owner
# track O-10) and the callback address (<API>/v1/oauth/shopify/callback). The secret also signs
# Shopify's webhooks (POST /webhooks/shopify). Unset: connecting answers "not configured".
# shopify, or fake for a built-in store (never in production)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8000/v1/oauth/shopify/callback
SHOPIFY_SCOPES=read_products
SHOPIFY_API_VERSION=2025-07
SHOPIFY_PROVIDER=shopify

# Razorpay payment links use each business's own keys (saved per workspace in the app), so there is
# nothing to set here. razorpay, or fake for a sandbox that accepts rzp_test_ keys (never in production)
RAZORPAY_PROVIDER=razorpay

# Local HTTPS tunnel for Meta (`pnpm tunnel` sets IG_REDIRECT_URI and API_BASE_URL to it)
# Your ngrok dev domain, e.g. something-random.ngrok-free.app, so the address never changes
NGROK_DOMAIN=

# Development only; production refuses to start with this on (SEC-14)
SANDBOX_PLATFORM_ENABLED=true
# Outbound webhooks (GR-04) to local receivers, for development. Production refuses true.
WEBHOOKS_ALLOW_PRIVATE=true
# Website crawls (GR-35) of local addresses, for development. Production refuses true.
CRAWL_ALLOW_PRIVATE=true
# Ask Amplychat draws visuals (GR-38: cards, ranked posts, sentiment) beside its answers. Off by
# default; turn on in staging first.
AGENT_VISUALS_ENABLED=false
# WhatsApp broadcasts (GR-23). Keep false in production until the legal check of marketing consent
# in India (O-11) is done; the e2e stack and tests turn it on.
BROADCASTS_ENABLED=false

# Rate limits (TR-API-07). false only for local load or end-to-end runs; production refuses it.
RATE_LIMITS_ENABLED=true
# The header with the caller's IP, for per-IP limits: x-forwarded-for on Render (read from the
# right, past Cloudflare and Render's proxies). Leave empty locally (the socket address is used).
CLIENT_IP_HEADER=

# Worker process concurrency (scripts/worker.sh)
WORKER_INTERACTIVE_CONCURRENCY=20
WORKER_BULK_CONCURRENCY=8

# Test suite overrides (tests never use DATABASE_URL or REDIS_URL)
# TEST_DATABASE_URL=postgresql+asyncpg://socialhood:socialhood@localhost:5432/socialhood_test
# TEST_DATABASE_URL_DIRECT=postgresql://socialhood:socialhood@localhost:5432/socialhood_test
# TEST_REDIS_URL=redis://localhost:6379/15
