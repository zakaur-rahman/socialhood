# Social Hood API and worker (§2.16). Copy to .env for local development.
# Values below are safe local defaults or blanks; production requires every blank to be set.

APP_ENV=local
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local Docker services (infra/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://socialhood:socialhood@localhost:5432/socialhood
DATABASE_URL_DIRECT=postgresql://socialhood:socialhood@localhost:5432/socialhood
BULK_CONCURRENCY_PER_WORKSPACE=4
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
# Sentry (T9.3): unset DSN = no Sentry. Release defaults to Render's RENDER_GIT_COMMIT.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=
# Guards /metrics and /readyz (SEC-12); unset = /metrics does not exist (404).
METRICS_TOKEN=

# Clerk (CLERK_JWT_KEY is the instance PEM public key; parties are comma-separated)
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SECRET=

# Fernet keys, newest first, comma-separated
TOKEN_ENCRYPTION_KEYS=

# Instagram API with Instagram Login
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:8000/v1/oauth/instagram/callback
IG_WEBHOOK_VERIFY_TOKEN=
IG_GRAPH_VERSION=v25.0
META_GRAPH_VERSION=v25.0
IG_REQUEST_INSIGHTS_SCOPE=false
IG_HUMAN_AGENT_ENABLED=false

# WhatsApp and Meta privacy callbacks
META_APP_ID=
META_APP_SECRET=
WHATSAPP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Gemini (paid-tier key only)
GEMINI_API_KEY=
AI_MODEL_ANALYSIS=gemini-3.5-flash-lite
AI_MODEL_REPLY=gemini-3.5-flash-lite
AI_MODEL_REPLY_COMPLEX=gemini-3.8-flash
AI_MODEL_EMBED=gemini-embedding-2
# Ask Social Hood's planner; unset: AI_MODEL_REPLY
# AI_MODEL_AGENT=gemini-3.5-flash-lite
AI_EMBED_DIM=768
# Thinking level per model (JSON); unset: minimal for Flash-Lite, low otherwise
# AI_THINKING_LEVELS={"gemini-3.8-flash": "low"}
AI_DAILY_SPEND_LIMIT_USD=100
AI_RETRIEVAL_MIN_SIM=0.60
AUTO_MIN_CONFIDENCE=0.75

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# test or live (test.dodopayments.com or live.dodopayments.com)
DODO_ENVIRONMENT=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_MAX_MONTHLY=
# dodo, or fake to run without Dodo (never in production)
DODO_PROVIDER=dodo

RESEND_API_KEY=
EMAIL_FROM=Social Hood <hello@socialhood.com>
# resend, or fake to keep emails in memory (never in production)
EMAIL_PROVIDER=resend

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@socialhood.com
# webpush, or fake to keep pushes in memory (never in production)
PUSH_PROVIDER=webpush

# Local HTTPS tunnel for Meta (`pnpm tunnel` sets IG_REDIRECT_URI and API_BASE_URL to it)
# Your ngrok dev domain, e.g. something-random.ngrok-free.app, so the address never changes
NGROK_DOMAIN=

# Development only; production refuses to start with this on (SEC-14)
SANDBOX_PLATFORM_ENABLED=true

# Rate limits (TR-API-07). false only for local load or end-to-end runs; production refuses it.
RATE_LIMITS_ENABLED=true
# The header with the caller's IP, for per-IP limits: x-forwarded-for on Render (read from the
# right, past Cloudflare and Render's proxies). Leave empty locally (the socket address is used).
CLIENT_IP_HEADER=

# Worker process concurrency (scripts/worker.sh)
WORKER_INTERACTIVE_CONCURRENCY=20
WORKER_BULK_CONCURRENCY=8

# Test suite overrides (tests never use DATABASE_URL or REDIS_URL)
# TEST_DATABASE_URL=postgresql+asyncpg://socialhood:socialhood@localhost:5432/socialhood_test
# TEST_DATABASE_URL_DIRECT=postgresql://socialhood:socialhood@localhost:5432/socialhood_test
# TEST_REDIS_URL=redis://localhost:6379/15
