# Amplychat web app (§2.16). Copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# The public site's origin for canonical URLs, Open Graph, structured data, sitemap.xml,
# robots.txt and llms.txt (C-142). Unset: https://amplychat.com (the apex; www redirects to it).
# Set it on staging (https://staging.amplychat.com) so staging never names production URLs.
NEXT_PUBLIC_SITE_URL=
# The signed-in app's own origin (C-146): production https://dashboard.amplychat.com. Set, the
# proxy (src/proxy.ts) serves app pages (/app, /w/…, sign-in, sign-up) only there and public
# pages only on NEXT_PUBLIC_SITE_URL, redirecting the rest; marketing CTAs link straight to it.
# Unset (local dev, e2e, CI): one origin serves everything and nothing redirects.
NEXT_PUBLIC_APP_URL=

# Site ownership tags (C-142): each <meta> is rendered only when its variable is set. Paste only
# the token (the content="..." value), not the whole tag. Production only.
# Google Search Console (HTML tag method): google-site-verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (HTML meta tag method): msvalidate.01
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Meta Business Manager → Brand safety → Domains (meta tag method): facebook-domain-verification
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
# The hosted status page's URL (C-156), e.g. https://status.amplychat.com. Set, the site footer
# links to it as "Status"; unset or not an http(s) URL, the link is hidden. Build time.
NEXT_PUBLIC_STATUS_URL=

# Clerk (from P1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Meta Embedded Signup (WhatsApp connect page only)
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=

# Sentry (T9.3): unset DSN = no Sentry. Source maps upload only when SENTRY_AUTH_TOKEN is set
# (Vercel build environment; never needed locally).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Push (TR-FE-09): the VAPID public key comes from the API's GET /v1/push/config (C-049).
# The service worker registers only in production builds; set to 1 to try push under next dev.
NEXT_PUBLIC_ENABLE_SW=
