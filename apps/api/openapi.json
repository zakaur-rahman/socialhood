{
  "components": {
    "schemas": {
      "Checklist": {
        "properties": {
          "completed": {
            "title": "Completed",
            "type": "integer"
          },
          "dismissed": {
            "title": "Dismissed",
            "type": "boolean"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/ChecklistStep"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "dismissed",
          "completed",
          "steps"
        ],
        "title": "Checklist",
        "type": "object"
      },
      "ChecklistStep": {
        "properties": {
          "done": {
            "title": "Done",
            "type": "boolean"
          },
          "key": {
            "enum": [
              "connect_account",
              "add_knowledge",
              "choose_ai_mode",
              "create_automation"
            ],
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key",
          "done"
        ],
        "title": "ChecklistStep",
        "type": "object"
      },
      "Me": {
        "properties": {
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_workspace_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Workspace Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "workspaces": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceSummary"
            },
            "title": "Workspaces",
            "type": "array"
          }
        },
        "required": [
          "id",
          "email",
          "workspaces"
        ],
        "title": "Me",
        "type": "object"
      },
      "Overview": {
        "properties": {
          "checklist": {
            "$ref": "#/components/schemas/Checklist"
          },
          "range": {
            "enum": [
              "7d",
              "30d"
            ],
            "title": "Range",
            "type": "string"
          }
        },
        "required": [
          "range",
          "checklist"
        ],
        "title": "Overview",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "items": {
              "properties": {
                "field": {
                  "title": "Field",
                  "type": "string"
                },
                "message": {
                  "title": "Message",
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ],
              "type": "object"
            },
            "title": "Errors",
            "type": "array"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "WorkspaceList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "WorkspaceList",
        "type": "object"
      },
      "WorkspaceOut": {
        "properties": {
          "automation_disclosure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Automation Disclosure"
          },
          "checklist_dismissed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checklist Dismissed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "plan": {
            "enum": [
              "free",
              "pro",
              "max"
            ],
            "title": "Plan",
            "type": "string"
          },
          "reply_language": {
            "title": "Reply Language",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "admin",
              "agent"
            ],
            "title": "Role",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "deleting"
            ],
            "title": "Status",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "timezone",
          "reply_language",
          "status",
          "role",
          "plan",
          "created_at"
        ],
        "title": "WorkspaceOut",
        "type": "object"
      },
      "WorkspacePatch": {
        "additionalProperties": false,
        "properties": {
          "automation_disclosure": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Automation Disclosure"
          },
          "checklist_dismissed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checklist Dismissed"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "reply_language": {
            "anyOf": [
              {
                "maxLength": 35,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply Language"
          },
          "slug": {
            "anyOf": [
              {
                "maxLength": 48,
                "minLength": 3,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "timezone": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "title": "WorkspacePatch",
        "type": "object"
      },
      "WorkspaceSummary": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "plan": {
            "enum": [
              "free",
              "pro",
              "max"
            ],
            "title": "Plan",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "admin",
              "agent"
            ],
            "title": "Role",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "timezone",
          "role",
          "plan"
        ],
        "title": "WorkspaceSummary",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Social Hood API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/me": {
      "get": {
        "description": "The current user, provisioned on first sight (TR-AUTH-03), with their workspaces.",
        "operationId": "get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (application/problem+json)"
          }
        },
        "summary": "Get Me",
        "tags": [
          "me"
        ]
      }
    },
    "/v1/w/{wid}": {
      "get": {
        "description": "Also remembers this workspace as the user's last one, for /app (F-02).",
        "operationId": "get_workspace",
        "parameters": [
          {
            "in": "path",
            "name": "wid",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Wid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation error"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (application/problem+json)"
          }
        },
        "summary": "Get Workspace",
        "tags": [
          "workspaces"
        ]
      },
      "patch": {
        "operationId": "update_workspace",
        "parameters": [
          {
            "in": "path",
            "name": "wid",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Wid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspacePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation error"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (application/problem+json)"
          }
        },
        "summary": "Update Workspace",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/v1/w/{wid}/overview": {
      "get": {
        "operationId": "get_overview",
        "parameters": [
          {
            "in": "path",
            "name": "wid",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Wid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "default": "7d",
              "enum": [
                "7d",
                "30d"
              ],
              "title": "Range",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation error"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (application/problem+json)"
          }
        },
        "summary": "Get Overview",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/v1/workspaces": {
      "get": {
        "operationId": "list_workspaces",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (application/problem+json)"
          }
        },
        "summary": "List Workspaces",
        "tags": [
          "me"
        ]
      }
    }
  }
}
